# Interpres environment configuration
# Copy this file to .env and fill in values as needed.
# .env is git-ignored.

# ===========================================
# Provider configuration (example values only)
# ===========================================
#OPENROUTER_API_KEY=sk-or-...
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#ANTHROPIC_API_KEY=sk-ant-...
#OLLAMA_BASE_URL=http://localhost:11434
#DEEPSEEK_API_KEY=sk-...

# ===========================================
# Pipeline behavior
# ===========================================
#INTERPRES_PROFILE=smoke
#INTERPRES_CACHE_DIR=.cache
#INTERPRES_ARTIFACTS_DIR=artifacts

# ===========================================
# Development / debugging
# ===========================================
#INTERPRES_LOG_LEVEL=INFO
#INTERPRES_DEBUG_PROVIDER=False
